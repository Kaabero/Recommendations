{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "rootDir": ".",                   
    "outDir": "dist",
    "types": ["jest"],                 
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
  },
  "include": [
    "app/**/*",
    "backend/**/*",
    "backend/tests/**/*.test.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}